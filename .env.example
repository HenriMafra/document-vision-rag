# ============================================================
# Projeto Palimpsesto MVP — Variaveis de ambiente
# Copie para .env (ou .env.local) e preencha os valores reais.
# NUNCA versionar o ficheiro preenchido.
# ============================================================

# Chave da API OpenAI — usada para GPT-4o (visao/raciocinio)
# e text-embedding-3-small (vetorizacao).
# Obter em: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# Connection string do Neon (Serverless PostgreSQL + pgvector).
# Obter em: Painel Neon -> Project -> Connection Details (Pooled connection).
DATABASE_URL=postgresql://USUARIO:SENHA@ep-xxxxx-pooler.REGIAO.aws.neon.tech/neondb?sslmode=require
